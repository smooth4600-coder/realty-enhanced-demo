# ---- Session signing ----
# There is no password. This signs the cookie that carries a visitor's
# remaining voice budget, so it survives a reload and a serverless restart.
AUTH_SECRET=generate-with-openssl-rand-hex-32

# ---- Text model (chat + listing writer) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Photo analysis decides correctness, so it gets the stronger model.
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5
# The copywriter never sees an image, so it can be the cheap one.
OPENROUTER_WRITER_MODEL=anthropic/claude-haiku-4.5

# ---- Voice (Retell web call, no phone number involved) ----
# A Retell agent configured for this brand, with the inbound phone prompt.
RETELL_API_KEY=
RETELL_AGENT_ID=

# ---- Cost guards. Lower these before the link goes to clients. ----
RATE_LIMIT_CHAT_PER_SESSION=20
# Total talk time per visitor. Not per call, and it does not reset daily.
RATE_LIMIT_VOICE_TOTAL_MINUTES=10
RATE_LIMIT_LISTING_PER_IP_PER_DAY=2
MAX_PHOTOS_PER_LISTING=10
RATE_LIMIT_CHAT_PER_IP_PER_DAY=30
